[Unit]
Description=Nemo device lock daemon
After=dbus.socket mce.service nemo-devicelock.socket sailfish-fpd-community.service
Requires=dbus.socket nemo-devicelock.socket
Wants=mce.service sailfish-fpd-community.service

[Service]
Type=notify
ExecStart=/usr/lib64/qt5/plugins/devicelock/encsfa-fpd --daemon
Restart=always
RestartSec=1

[Install]
Alias=nemo-devicelock.service
WantedBy=multi-user.target
